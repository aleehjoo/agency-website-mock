# ==============================================================================
# CONTACT FORM & EMAIL DELIVERY
# ==============================================================================
# The address where form submissions should be sent
CONTACT_TO_EMAIL=umila.alejandro@gmail.com

# The address the emails will be sent FROM (must be verified in Resend/SMTP)
EMAIL_FROM=noreply@fivefoldindustries.com

# OPTION 1: RESEND (Primary)
# If this key is provided, the app will use Resend exclusively
RESEND_API_KEY=re_123456789

# OPTION 2: SMTP FALLBACK 
# If RESEND_API_KEY is omitted, the app will attempt SMTP delivery using these
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
